{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted uptime monitoring and public status pages",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "postinstall": "pnpm --filter @pulse/api exec npm rebuild better-sqlite3 --silent",
    "dev": "pnpm --parallel --filter @pulse/api --filter @pulse/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
